# MediKiosk Frontend Environment Variables

# Backend API Base URL (HTTP/HTTPS)
# Local development default: http://127.0.0.1:8000
# Production example: https://your-backend-service.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# WebSocket Base URL (Optional - defaults automatically to ws:// or wss:// based on VITE_API_BASE_URL)
# VITE_WS_BASE_URL=ws://127.0.0.1:8000
