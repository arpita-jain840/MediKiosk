# ==============================================================================
# MediKiosk Database & AI Core Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION (PostgreSQL)
# ------------------------------------------------------------------------------
# For Local PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:your_password@localhost:5432/medikiosk"
#
# For Cloud PostgreSQL (Supabase / Neon.tech):
# DATABASE_URL="postgresql+asyncpg://user:password@ep-cool-xyz.us-east-2.aws.neon.tech/neondb?ssl=require"
#
# If left empty, the server automatically falls back to local async SQLite (medikiosk.db)
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. AI MODEL KEYS
# ------------------------------------------------------------------------------
# Google Gemini API Key (For Multimodal Vision OCR on Parche/Reports & Structured Clinical JSON generation)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Groq API Key (For ultra-fast Whisper Speech-To-Text audio intake)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# ------------------------------------------------------------------------------
# 3. SPEECH-TO-TEXT PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Provider Toggle: "whisper" (via Groq) or "bhashini" (Government of India Indic ASR)
STT_PROVIDER=whisper

# Optional: Bhashini Indic Language Credentials
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=